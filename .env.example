# ─── NEXUS Configuration ─────────────────────────────────────
# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored — never commit secrets.

# Binance (public endpoints work without keys for market data)
# VITE_BINANCE_WS_URL=wss://stream.binance.com:9443
# VITE_BINANCE_REST_URL=https://api.binance.com
# VITE_BINANCE_FUTURES_WS_URL=wss://fstream.binance.com
# VITE_BINANCE_FUTURES_REST_URL=https://fapi.binance.com

# Corporate Intelligence (Polygon.io, Finnhub, etc.)
# VITE_POLYGON_API_KEY=your_polygon_key_here
# VITE_FINNHUB_API_KEY=your_finnhub_key_here

# Macro Data (FRED)
# VITE_FRED_API_KEY=your_fred_key_here

# Refresh interval (milliseconds)
# VITE_REFRESH_INTERVAL_MS=5000

# WebSocket reconnection
# VITE_WS_RECONNECT_MAX=10
# VITE_WS_RECONNECT_MAX_DELAY=30000

# Data retention (days)
# VITE_IDB_RETENTION_DAYS=7
# VITE_SIGNAL_RETENTION_DAYS=30
