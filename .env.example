# ─── NEXUS Configuration ─────────────────────────────────────
# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored — never commit secrets.
# Source of truth for what's read: src/infra/env.ts

# ─── Binance ────────────────────────────────────────────────
# Public endpoints work without keys for market data. Override
# only when targeting test net or a specific region.
# VITE_BINANCE_WS_URL=wss://stream.binance.com:9443
# VITE_BINANCE_REST_URL=https://api.binance.com
# VITE_BINANCE_FUTURES_WS_URL=wss://fstream.binance.com
# VITE_BINANCE_FUTURES_REST_URL=https://fapi.binance.com

# ─── Equities / forex / macro (planned) ─────────────────────
# Provider scaffolding exists in src/providers/ but isn't wired live yet.
# See READINESS.md for the broker decision still to make.
# VITE_POLYGON_API_KEY=your_polygon_key_here
# VITE_FINNHUB_API_KEY=your_finnhub_key_here
# VITE_FRED_API_KEY=your_fred_key_here

# ─── AI orchestration ──────────────────────────────────────
# Anthropic — enables Claude-backed decisions in the Chain pipeline.
# When unset, NEXUS falls back to the deterministic rule-based provider.
# VITE_ANTHROPIC_API_KEY=sk-ant-...
# VITE_ANTHROPIC_MODEL=claude-sonnet-4-5

# xAI — enables Grok as a second provider for consensus orchestration.
# Optional: when both this and the Anthropic key are set, the chain
# runs both and aggregates via majority vote + weighted confidence.
# VITE_XAI_API_KEY=xai-...
# VITE_XAI_MODEL=grok-4

# ─── Refresh tuning ────────────────────────────────────────
# How often the store re-fetches snapshots + recomputes analytics.
# 5000 (5s) is a sweet spot — under that you risk hammering REST
# endpoints, above and the chart "feels" stale.
# VITE_REFRESH_INTERVAL_MS=5000

# WebSocket reconnection (Binance + Coinbase)
# VITE_WS_RECONNECT_MAX=10
# VITE_WS_RECONNECT_MAX_DELAY=30000

# ─── Data retention (days) ─────────────────────────────────
# Snapshots and candles persist to IndexedDB; older entries get
# pruned at startup. Signals have their own retention since they
# matter longer for backtesting than raw market snapshots.
# VITE_IDB_RETENTION_DAYS=7
# VITE_SIGNAL_RETENTION_DAYS=30
